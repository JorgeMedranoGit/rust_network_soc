@startuml
skinparam backgroundColor #1E1E2E
skinparam defaultFontName Arial
skinparam defaultFontColor #CDD6F4
skinparam defaultFontSize 10
skinparam roundcorner 8
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 40

skinparam node {
    BackgroundColor #181825
    BorderColor #89B4FA
    FontColor #CDD6F4
    FontStyle bold
    BorderThickness 1.2
}

skinparam component {
    BackgroundColor #313244
    BorderColor #94E2D5
    FontColor #CDD6F4
    BorderThickness 1.2
}

skinparam artifact {
    BackgroundColor #313244
    BorderColor #CBA6F7
    FontColor #CDD6F4
    BorderThickness 1.2
}

skinparam database {
    BackgroundColor #313244
    BorderColor #89B4FA
    FontColor #CDD6F4
    BorderThickness 1.2
}

skinparam folder {
    BackgroundColor #181825
    BorderColor #A6ADC8
    FontColor #CDD6F4
    BorderThickness 1.2
}

skinparam file {
    BackgroundColor #313244
    BorderColor #89B4FA
    FontColor #CDD6F4
    BorderThickness 1.2
}

skinparam cloud {
    BackgroundColor #181825
    BorderColor #89DCEB
    FontColor #CDD6F4
    BorderThickness 1.2
}

skinparam arrow {
    Color #89B4FA
    FontColor #A6ADC8
    FontSize 9
}

top to bottom direction

node "Servidor Host Linux (AS27839 SOC Server)" as HostServer {

    node "Contenedor Docker: tigo_rust_backend" as DockerBackend << Execution Environment >> {
        artifact "tigo_soc_backend\n(Binario ELF)" as BinBackend
        artifact "mejor_modelo_kfold.txt\n(Modelo LightGBM)" as ModelArtifact
        artifact "tigo_soc_frontend.wasm\n(Artefacto WASM)" as WasmArtifact
        component "Axum Engine\n(Puerto 3000)" as AxumComp
        component "Polars Engine\n(SIMD Vectorized)" as PolarsComp
        component "LightGBM C-API\n(Inferencia)" as BoosterComp
        component "Sensor Sockets\n(AF_PACKET)" as SensorComp
    }

    node "Contenedor Docker: tigo_postgres_db" as DockerDB << Database Server >> {
        database "PostgreSQL 15 (BCNF)" as PostgresDB {
            folder "Tablespace tigo_soc" as TigoSOCData
        }
    }

    folder "Almacenamiento Persistente Host" as HostStorage {
        file "bd/data/ (Volumen PostgreSQL)" as VolDB
        file "bd/init.sql (Script Inicial)" as InitSql
        file ".env (Variables de Entorno)" as EnvFile
    }
}

node "Entorno Virtualizado de Telecomunicaciones (GNS3 Core AS27839)" as GNS3Env {
    node "Router_Core_L3 (MikroTik / Cisco IOS)" as RouterCore
    node "pfSense_Gateway (NGFW RESTCONF)" as PfSense
    node "Cisco ISE / FreeRADIUS (AAA / CoA)" as CiscoISE
    node "AttackerKali (Inyector de Ataques)" as AttackerKali
    node "VictimeAlpine1..9 (Estaciones LAN)" as Victims
    node "Sandbox_VLAN_999 (VLAN Aislada 10.200.0.0/24)" as SandboxVlan
}

node "Dispositivos Clientes del SOC" as ClientesArea {
    node "Estación Desktop (1440x900)" as ClientDesktop {
        artifact "Leptos WASM Runtime (Desktop View)" as WASMDesktop
    }

    node "Tablet Táctica (1024x768)" as ClientTablet {
        artifact "Leptos WASM Runtime (Tablet View)" as WASMTablet
    }

    node "Dispositivo Móvil (390x844)" as ClientMobile {
        artifact "Leptos WASM (Mobile View)" as WASMMobile
        component "FCM Worker" as FCMWorker
    }
}

cloud "Google Firebase Cloud Services" as GoogleCloud {
    component "FCM Push Notification Service" as FCMService
}

SensorComp .down.> RouterCore : Captura modo promiscuo
SensorComp .down.> PfSense : Inspección L2-L7
AxumComp -right-> PostgresDB : TCP 5432 (Pool SQLx)
VolDB .up.> PostgresDB : Montaje de volumen

HostServer -down-> ClientesArea : HTTPS 3000 / WSS Telemetry

AxumComp -down-> FCMService : HTTP v1 OAuth2
FCMService -down-> FCMWorker : Alertas Push Forenses

DockerBackend .down.> CiscoISE : RADIUS CoA (Puerto 1700/3799)
DockerBackend .down.> RouterCore : BGP Blackhole / SSH CLI
DockerBackend .down.> PfSense : RESTCONF HTTPS 8443 / YANG

AttackerKali -right-> Victims : DNS Tunneling (dnscat2)
SandboxVlan .up.> DockerBackend : Validación previa de ACLs

@enduml
