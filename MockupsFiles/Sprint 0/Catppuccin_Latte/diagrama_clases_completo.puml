    BackgroundColor #E6E9EF
    BorderColor #7287FD
    FontColor #4C4F69
    FontStyle bold
    BorderThickness 1.2
}

skinparam rectangle {
    BackgroundColor #DCE0E8
    BorderColor #1E66F5
    FontColor #4C4F69
    BorderThickness 1.5
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #1E66F5
    FontColor #4C4F69
    BorderThickness 1.2
}

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E66F5
    FontColor #4C4F69
    HeaderBackgroundColor #E6E9EF
    BorderThickness 1.2
}

skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #1E66F5
    FontColor #4C4F69
    HeaderBackgroundColor #E6E9EF
    BorderThickness 1.2
}

skinparam node {
    BackgroundColor #E6E9EF
    BorderColor #1E66F5
    FontColor #4C4F69
    BorderThickness 1.2
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #209FB5
    FontColor #4C4F69
    BorderThickness 1.2
}

skinparam artifact {
    BackgroundColor #FFFFFF
    BorderColor #8839EF
    FontColor #4C4F69
    BorderThickness 1.2
}

